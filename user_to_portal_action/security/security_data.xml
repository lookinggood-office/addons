<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Hiding Administrator (ID 1) from non-admins -->
    <record id="res_users_hide_admin_rule" model="ir.rule">
        <field name="name">Hide Administrator from non-admins</field>
        <field name="model_id" ref="base.model_res_users"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)] if user.id == 1 else [('id', '!=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>
