<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="site_header_phone_cleanup" inherit_id="website.header_text_element" name="Hide placeholder phone number">
        <xpath expr="//a[starts-with(@href, 'tel:+1 555-555-5556')]" position="replace"/>
    </template>
    <template id="site_header_call_to_action" inherit_id="website.header_call_to_action" name="Directory registration call to action">
        <xpath expr="//a[@href='/contactus'][hasclass('btn_cta')]" position="replace">
            <a href="/contactus" class="oe_unremovable btn btn-primary btn_cta d-none" aria-hidden="true" tabindex="-1"/>
        </xpath>
    </template>
    <template id="warehouse_theme_toggle_desktop" inherit_id="website.template_header_default" name="Website light and dark theme toggle">
        <xpath expr="//div[@id='o_main_nav']/ul" position="inside">
            <li class="nav-item">
                <button type="button" class="warehouse-theme-toggle nav-link btn border-0" data-warehouse-theme-toggle="1" aria-label="Switch to dark mode" aria-pressed="false" title="Switch to dark mode">
                    <i class="fa fa-moon-o" aria-hidden="true"/>
                    <span data-warehouse-theme-label="1">Dark mode</span>
                </button>
            </li>
        </xpath>
    </template>
    <template id="warehouse_theme_toggle_mobile" inherit_id="website.template_header_mobile" name="Mobile website light and dark theme toggle">
        <xpath expr="//ul[hasclass('o_header_mobile_buttons_wrap')]" position="inside">
            <li class="nav-item">
                <button type="button" class="warehouse-theme-toggle nav-link btn p-2 o_not_editable" data-warehouse-theme-toggle="1" aria-label="Switch to dark mode" aria-pressed="false" title="Switch to dark mode">
                    <i class="fa fa-moon-o" aria-hidden="true"/>
                    <span class="visually-hidden" data-warehouse-theme-label="1">Dark mode</span>
                </button>
            </li>
        </xpath>
    </template>
    <template id="remove_odoo_brand_promotion" inherit_id="website.layout" name="Remove Odoo footer promotion">
        <xpath expr="//t[@t-call='web.brand_promotion']/.." position="replace"/>
    </template>
</odoo>
