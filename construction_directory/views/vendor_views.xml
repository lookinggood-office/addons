<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="construction_vendor_view_list" model="ir.ui.view">
        <field name="name">construction.vendor.list</field>
        <field name="model">construction.vendor</field>
        <field name="arch" type="xml">
            <list string="ตัวแทนวัสดุก่อสร้าง" default_order="profile_revision_pending desc, is_published, create_date desc, name" decoration-warning="not is_published" decoration-info="profile_revision_pending">
                <field name="sequence" widget="handle"/>
                <field name="image_1920" string="โลโก้" widget="image" optional="hide"/>
                <field name="name"/>
                <field name="province_id"/>
                <field name="category_ids" widget="many2many_tags"/>
                <field name="contact_phone"/>
                <field name="line_url" optional="hide"/>
                <field name="facebook_url" optional="hide"/>
                <field name="publication_consent" optional="hide"/>
                <field name="profile_revision_pending" string="แก้ไขรอตรวจ"/>
                <field name="featured" widget="boolean_toggle"/>
                <field name="is_sponsored" string="ตัวแทนแนะนำ" widget="boolean_toggle" optional="hide"/>
                <field name="is_published" string="เผยแพร่" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="construction_vendor_view_form" model="ir.ui.view">
        <field name="name">construction.vendor.form</field>
        <field name="model">construction.vendor</field>
        <field name="arch" type="xml">
            <form string="ตัวแทนวัสดุก่อสร้าง">
                <header>
                    <field name="is_published" widget="boolean_toggle" string="เผยแพร่บนเว็บไซต์"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <field name="image_1920" widget="image" class="oe_avatar"/>
                    <div class="oe_title"><label for="name"/><h1><field name="name" placeholder="ชื่อบริษัทหรือตัวแทน"/></h1></div>
                    <div class="alert alert-warning" role="alert" invisible="not profile_revision_pending">
                        มีข้อมูลโปรไฟล์ฉบับใหม่รอตรวจ โปรดเปิดแท็บ “ข้อมูลรอตรวจ” ก่อนอนุมัติ
                    </div>
                    <notebook>
                        <page string="ข้อมูลบริษัทและพื้นที่">
                            <group>
                                <group string="รูปภาพบริษัท">
                                    <field name="cover_image" widget="image" options="{'size': [240, 120]}"/>
                                    <field name="representative_image" widget="image" options="{'size': [100, 100]}"/>
                                </group>
                                <group string="พื้นที่และหมวดหมู่">
                                    <field name="province_id" options="{'no_create': True}"/>
                                    <field name="district"/>
                                    <field name="street"/>
                                    <field name="zip"/>
                                    <field name="category_ids" widget="many2many_tags"/>
                                </group>
                            </group>
                            <group string="รายละเอียดบริษัท"><field name="description" widget="html"/></group>
                            <group string="บัญชีตัวแทน"><field name="user_id" readonly="1"/></group>
                        </page>
                        <page string="ช่องทางติดต่อและการแสดงผล">
                            <group>
                                <group string="ข้อมูลติดต่อ">
                                    <field name="contact_name"/>
                                    <field name="working_hours" placeholder="จ.-ศ. 08:30–17:30"/>
                                    <field name="contact_phone"/>
                                    <field name="contact_email"/>
                                    <field name="website_url"/>
                                    <field name="line_url"/>
                                    <field name="facebook_url"/>
                                </group>
                                <group string="การแสดงผลบนเว็บไซต์">
                                    <field name="publication_consent"/>
                                    <field name="publication_consent_date" invisible="not publication_consent"/>
                                    <field name="featured" string="แนะนำเป็นรายการเด่น" widget="boolean_toggle"/>
                                    <field name="is_sponsored" string="ตัวแทนแนะนำ" widget="boolean_toggle"/>
                                    <field name="sponsor_start" string="เริ่มแนะนำวันที่" invisible="not is_sponsored"/>
                                    <field name="sponsor_end" string="สิ้นสุดวันที่แนะนำ" invisible="not is_sponsored"/>
                                    <field name="sequence" string="ลำดับแสดงผล"/>
                                </group>
                            </group>
                        </page>
                        <page string="สินค้า" name="vendor_products">
                            <field name="product_ids" context="{'default_vendor_id': id}">
                                <list editable="bottom" default_order="sequence, name" decoration-muted="not active">
                                    <field name="sequence" widget="handle"/>
                                    <field name="image_1920" string="รูปปก" widget="image" optional="show"/>
                                    <field name="name"/>
                                    <field name="category_id"/>
                                    <field name="price"/>
                                    <field name="image_count" string="จำนวนรูป"/>
                                    <field name="is_published" string="เผยแพร่" widget="boolean_toggle"/>
                                    <field name="active" string="ใช้งาน" widget="boolean_toggle"/>
                                </list>
                                <form string="สินค้า">
                                    <sheet>
                                        <group>
                                            <group>
                                                <field name="image_1920" widget="image"/>
                                                <field name="name"/>
                                                <field name="category_id"/>
                                                <field name="price"/>
                                            </group>
                                            <group>
                                                <field name="image_count"/>
                                                <field name="is_published"/>
                                                <field name="active"/>
                                            </group>
                                        </group>
                                        <notebook>
                                            <page string="รายละเอียด"><field name="description" widget="html"/></page>
                                            <page string="รูปเพิ่มเติม">
                                                <div class="text-muted">รวมรูปปกแล้วได้ไม่เกิน 7 รูป</div>
                                                <field name="image_ids">
                                                    <list editable="bottom">
                                                        <field name="sequence" widget="handle"/>
                                                        <field name="image_1920" widget="image"/>
                                                    </list>
                                                </field>
                                            </page>
                                        </notebook>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                        <page string="ข้อมูลรอตรวจ" invisible="not profile_revision_ids">
                            <field name="profile_revision_ids" readonly="1">
                                <list>
                                    <field name="submitted_at"/>
                                    <field name="name"/>
                                    <field name="province_id"/>
                                    <field name="contact_phone"/>
                                    <button name="action_approve" type="object" string="อนุมัติ" class="btn-primary"/>
                                    <button name="action_reject" type="object" string="ปฏิเสธ" class="btn-secondary" confirm="ยืนยันลบข้อมูลที่ส่งมา?"/>
                                </list>
                                <form string="ข้อมูลที่ส่งมาเพื่อตรวจ">
                                    <header>
                                        <button name="action_approve" type="object" string="อนุมัติและใช้ข้อมูลนี้" class="btn-primary"/>
                                        <button name="action_reject" type="object" string="ปฏิเสธข้อมูล" class="btn-secondary" confirm="ยืนยันลบข้อมูลที่ส่งมา?"/>
                                    </header>
                                    <sheet>
                                        <group>
                                            <group><field name="name"/><field name="province_id"/><field name="district"/><field name="category_ids" widget="many2many_tags"/></group>
                                            <group><field name="contact_name"/><field name="working_hours"/><field name="contact_phone"/><field name="contact_email"/><field name="website_url"/><field name="line_url"/><field name="facebook_url"/></group>
                                        </group>
                                        <group><field name="description" widget="html"/></group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="construction_vendor_view_search" model="ir.ui.view">
        <field name="name">construction.vendor.search</field>
        <field name="model">construction.vendor</field>
        <field name="arch" type="xml">
            <search string="ค้นหาตัวแทน">
                <field name="name" string="บริษัท / ตัวแทน" filter_domain="['|', '|', ('name', 'ilike', self), ('contact_phone', 'ilike', self), ('contact_email', 'ilike', self)]"/>
                <field name="province_id"/>
                <field name="category_ids"/>
                <filter name="needs_review" string="ต้องตรวจ" domain="['|', ('is_published', '=', False), ('profile_revision_pending', '=', True)]"/>
                <filter name="pending" string="ยังไม่เผยแพร่" domain="[('is_published', '=', False)]"/>
                <filter name="profile_changes" string="มีข้อมูลแก้ไขรอตรวจ" domain="[('profile_revision_pending', '=', True)]"/>
                <filter name="published" string="เผยแพร่แล้ว" domain="[('is_published', '=', True)]"/>
                <group>
                    <filter name="group_province" string="จังหวัด" context="{'group_by': 'province_id'}"/>
                    <filter name="group_category" string="หมวดหมู่" context="{'group_by': 'category_ids'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="construction_vendor_action" model="ir.actions.act_window">
        <field name="name">ตัวแทนวัสดุก่อสร้าง</field>
        <field name="res_model">construction.vendor</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="construction_vendor_view_search"/>
    </record>
    <record id="construction_vendor_product_view_list" model="ir.ui.view">
        <field name="name">construction.vendor.product.list</field>
        <field name="model">construction.vendor.product</field>
        <field name="arch" type="xml">
            <list string="สินค้าตัวแทน" default_order="sequence, name">
                <field name="sequence" widget="handle"/><field name="image_1920" widget="image" optional="hide"/>
                <field name="name"/><field name="vendor_id"/><field name="category_id"/><field name="price"/>
                <field name="is_published" widget="boolean_toggle"/><field name="active" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="construction_vendor_product_view_form" model="ir.ui.view">
        <field name="name">construction.vendor.product.form</field>
        <field name="model">construction.vendor.product</field>
        <field name="arch" type="xml">
            <form string="สินค้าตัวแทน">
                <header><field name="is_published" widget="boolean_toggle" string="เผยแพร่บนเว็บไซต์"/></header>
                <sheet><group>
                    <group><field name="image_1920" widget="image"/><field name="name"/><field name="vendor_id"/><field name="category_id"/></group>
                    <group><field name="price"/><field name="sequence"/><field name="active"/></group>
                </group><notebook><page string="รายละเอียดสินค้า"><field name="description" widget="html"/></page></notebook></sheet>
            </form>
        </field>
    </record>
    <record id="construction_vendor_product_action" model="ir.actions.act_window">
        <field name="name">สินค้าตัวแทน</field><field name="res_model">construction.vendor.product</field><field name="view_mode">list,form</field>
    </record>
    <record id="construction_directory_search_group_view_list" model="ir.ui.view">
        <field name="name">construction.directory.search.group.list</field>
        <field name="model">construction.directory.search.group</field>
        <field name="arch" type="xml">
            <list string="กลุ่มค้นหาหน้าเว็บไซต์">
                <field name="sequence" widget="handle"/>
                <field name="image_1920" string="รูปปก" widget="image" options="{'size': [72, 48]}" optional="show"/>
                <field name="name" string="ชื่อกลุ่ม"/>
                <field name="category_type" string="กลุ่มระบบ"/>
                <field name="active" string="แสดงบนเว็บไซต์" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="construction_directory_search_group_view_form" model="ir.ui.view">
        <field name="name">construction.directory.search.group.form</field>
        <field name="model">construction.directory.search.group</field>
        <field name="arch" type="xml">
            <form string="กลุ่มค้นหาหน้าเว็บไซต์">
                <sheet>
                    <group>
                        <group>
                            <field name="name" string="ชื่อกลุ่มที่แสดง"/>
                            <field name="category_type" string="ประเภทกลุ่ม" readonly="1"/>
                            <field name="sequence" string="ลำดับแสดงผล"/>
                            <field name="active" string="แสดงบนเว็บไซต์"/>
                            <field name="description" string="คำอธิบายสั้น ๆ"/>
                        </group>
                        <group string="รูปภาพหน้าปกกลุ่ม">
                            <field name="image_1920" string="รูปหน้าปก" widget="image" options="{'size': [320, 180]}"/>
                            <div class="text-muted">รูปนี้แสดงในการ์ดเลือกกลุ่มบนหน้าแรกของเว็บไซต์</div>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="construction_directory_search_group_action" model="ir.actions.act_window">
        <field name="name">กลุ่มค้นหาหน้าเว็บไซต์</field>
        <field name="res_model">construction.directory.search.group</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="construction_vendor_category_view_list" model="ir.ui.view">
        <field name="name">construction.vendor.category.list</field>
        <field name="model">construction.vendor.category</field>
        <field name="arch" type="xml">
            <list string="จัดการหมวดหมู่">
                <field name="sequence" widget="handle"/>
                <field name="image_1920" string="รูปปก" widget="image" optional="show"/>
                <field name="name"/>
                <field name="category_type" string="กลุ่ม"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="construction_vendor_category_view_form" model="ir.ui.view">
        <field name="name">construction.vendor.category.form</field>
        <field name="model">construction.vendor.category</field>
        <field name="arch" type="xml">
            <form string="จัดการหมวดหมู่">
                <sheet>
                    <group>
                        <group>
                            <field name="name" string="ชื่อหมวดหมู่"/>
                            <field name="category_type" string="กลุ่มที่ใช้ค้นหา"/>
                            <field name="sequence" string="ลำดับแสดงผล"/>
                            <field name="active" string="เปิดใช้งาน"/>
                        </group>
                        <group string="รูปภาพหมวดหมู่">
                            <field name="image_1920" string="รูปปกหมวดหมู่" widget="image" options="{'size': [240, 160]}"/>
                            <div class="text-muted">รูปนี้จะแสดงเป็นภาพปกของหมวดหมู่บนหน้าเว็บไซต์</div>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="construction_vendor_category_action" model="ir.actions.act_window">
        <field name="name">จัดการหมวดหมู่</field>
        <field name="res_model">construction.vendor.category</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="construction_directory_menu_root" name="จัดการตัวแทนวัสดุ" sequence="55"/>
    <menuitem id="construction_vendor_menu" name="ตัวแทนวัสดุก่อสร้าง" parent="construction_directory_menu_root" action="construction_vendor_action" sequence="10"/>
    <menuitem id="construction_directory_search_group_menu" name="กลุ่มค้นหาเว็บไซต์" parent="construction_directory_menu_root" action="construction_directory_search_group_action" sequence="15"/>
    <menuitem id="construction_vendor_category_menu" name="จัดการหมวดหมู่" parent="construction_directory_menu_root" action="construction_vendor_category_action" sequence="20"/>
</odoo>
