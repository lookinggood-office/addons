<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-inherit="hr_attendance.public_kiosk_app" t-inherit-mode="extension">

    <xpath expr="//*[1]" position="inside">
        
        <!-- Responsive Floating Button -->
        <div class="passkey-floating-container" t-if="!passkeyState.isAuthenticating">
            <button class="btn btn-primary passkey-floating-btn d-flex align-items-center justify-content-center gap-2 px-4 py-3 shadow-lg"
                    t-on-click="onPasskeyClick">
                <i class="fa fa-fingerprint fs-4"/>
                <span class="fw-bold">Passkey Sign-In</span>
            </button>
        </div>

        <!-- Responsive Verification Overlay -->
        <div t-if="passkeyState.isAuthenticating" class="passkey-verify-overlay d-flex align-items-center justify-content-center">
             <div class="passkey-verify-card d-flex flex-column align-items-center text-center">
                 <div class="mb-4 text-primary animate-pulse">
                     <i class="fa fa-shield fa-4x"/>
                 </div>
                 <h3 class="fw-bold text-dark">Secure Verification</h3>
                 <p class="text-muted mb-4">Please follow the prompt on your device to continue.</p>
                 <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status"></div>
                 <div class="mt-3 text-primary small fw-bold">Waiting for Authenticator...</div>
             </div>
        </div>
    </xpath>

</t>

</templates>
