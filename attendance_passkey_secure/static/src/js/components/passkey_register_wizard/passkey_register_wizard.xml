<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="attendance_passkey_secure.PasskeyRegisterWizard">
    <div class="passkey-register-wizard o_form_view h-100 d-flex flex-column bg-white">
        
        <!-- Standard Odoo Modal Header Style -->
        <div class="modal-header d-flex align-items-center justify-content-between py-3 px-4 border-bottom bg-light">
            <h4 class="modal-title fw-bold text-dark m-0">
                <i class="fa fa-shield me-2 text-primary"/>Device Registration
            </h4>
            <button class="btn-close" t-on-click="onClose" aria-label="Close"></button>
        </div>

        <div class="modal-body flex-grow-1 p-0 overflow-auto">
            
            <!-- Employee Info Banner -->
            <div class="bg-primary-light p-3 border-bottom d-flex align-items-center gap-3" style="background: #f8f9fa;">
                <div class="rounded-circle bg-white d-flex align-items-center justify-content-center shadow-sm" style="width: 40px; height: 40px;">
                    <i class="fa fa-user text-primary"/>
                </div>
                <div>
                    <div class="small text-muted">Registering for</div>
                    <div class="fw-bold text-dark" t-esc="employeeName"/>
                </div>
            </div>

            <div class="p-4">
                <!-- STEP 1: IDLE -->
                <t t-if="state.phase === 'idle'">
                    <div class="o_group mb-4">
                        <div class="mb-3">
                            <label class="o_form_label fw-bold mb-1">Device Name</label>
                            <input type="text"
                                   class="o_input form-control p-3 fs-5"
                                   placeholder="e.g. My Work Laptop"
                                   t-model="state.deviceName"
                                   style="border: 2px solid #dee2e6; border-radius: 8px;"/>
                            <div class="o_form_help text-muted mt-2 small">
                                Use a unique name to identify this device in your passkey list.
                            </div>
                        </div>
                    </div>
                    
                    <div class="o_horizontal_separator text-uppercase fw-bold text-primary small mb-3">About Passkeys</div>
                    <div class="d-flex gap-3 text-muted">
                        <i class="fa fa-check-circle text-success mt-1"/>
                        <p class="small m-0">Passkeys use your device's biometrics (Fingerprint/FaceID) for a secure, passwordless experience.</p>
                    </div>
                </t>

                <!-- STEP 2: REGISTERING -->
                <div t-if="state.phase === 'registering'" class="text-center py-5">
                    <div class="mb-4">
                        <i class="fa fa-fingerprint fa-5x text-primary animate-pulse"/>
                    </div>
                    <h4 class="fw-bold">Waiting for Device</h4>
                    <p class="text-muted">Please follow the security instructions on your browser...</p>
                    <div class="spinner-grow text-primary mt-3" role="status"></div>
                </div>

                <!-- STEP 3: SUCCESS -->
                <div t-if="state.phase === 'success'" class="text-center py-5">
                    <div class="rounded-circle bg-success text-white d-inline-flex align-items-center justify-content-center mb-4 shadow" style="width: 80px; height: 80px;">
                        <i class="fa fa-check fa-3x"/>
                    </div>
                    <h3 class="fw-bold text-success">Registration Successful</h3>
                    <p class="text-muted px-5">This device is now linked. You can close this window and start using it at the kiosk.</p>
                </div>

                <!-- STEP 4: ERROR -->
                <div t-if="state.phase === 'error'" class="text-center py-5">
                    <div class="rounded-circle bg-danger text-white d-inline-flex align-items-center justify-content-center mb-4 shadow" style="width: 80px; height: 80px;">
                        <i class="fa fa-exclamation fa-3x"/>
                    </div>
                    <h3 class="fw-bold text-danger">Setup Failed</h3>
                    <p class="text-muted" t-esc="state.message"/>
                </div>
            </div>
        </div>

        <!-- Standard Odoo Modal Footer -->
        <div class="modal-footer border-top p-3 bg-light d-flex justify-content-end gap-2">
            <t t-if="state.phase === 'idle'">
                <button class="btn btn-secondary px-4 py-2 fw-bold" t-on-click="onClose">Cancel</button>
                <button class="btn btn-primary px-4 py-2 fw-bold" t-on-click="onRegister">Register Device</button>
            </t>
            <t t-if="state.phase === 'error'">
                <button class="btn btn-secondary px-4 py-2 fw-bold" t-on-click="onClose">Close</button>
                <button class="btn btn-primary px-4 py-2 fw-bold" t-on-click="onRetry">Retry</button>
            </t>
            <t t-if="state.phase === 'success'">
                <button class="btn btn-success w-100 py-3 fw-bold" t-on-click="onClose">Finish</button>
            </t>
        </div>
    </div>
</t>

</templates>
